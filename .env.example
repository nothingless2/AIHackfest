# Endpoint alternatif yang kompatibel-OpenAI (relay/proxy/self-host).
# Kosongkan untuk memakai endpoint resmi OpenAI.
# Diverifikasi bekerja lewat relay: chat.completions, json_object, vision,
# audio.transcriptions (Whisper), dan audio.speech (TTS).
OPENAI_BASE_URL=

OPENAI_API_KEY=

# Nama model untuk SEMUA panggilan chat (brief, seleksi konten, koreksi durasi).
# Kosong = gpt-4o. Contoh penyedia lain: anthropic/claude-haiku-4.5
LLM_MODEL=

# Model cadangan, dipisah koma, dicoba kalau model utama tidak bisa melayani
# SEKARANG (dicabut penyedia, 429 antrean penuh, 5xx). Kuota habis dan kunci
# salah TIDAK memicu pindah model -- itu tidak akan membaik di model lain.
# Asal: 25 Sep model gratis utama dicabut OpenRouter ("No endpoints found").
LLM_FALLBACK=
# Berapa kali seluruh rantai (utama + cadangan) diputar. Bawaan 2.
# JANGAN ditulis kosong (LLM_FALLBACK_ROUNDS=): nilai kosong membuat import gagal (ValueError saat import). Buka # hanya untuk mengubah.
# LLM_FALLBACK_ROUNDS=2

# Transkripsi: "auto" (default) memakai Whisper LOKAL kalau sudah dipasang
# (bash scripts/setup_local_whisper.sh), selain itu API. Isi "api" untuk memaksa API.
TRANSCRIBE_PROVIDER=

# Transkripsi (Whisper) dan TTS bisa memakai penyedia SENDIRI. Perlu kalau
# penyedia chat tidak punya keduanya (mis. Snifox: hanya model chat).
# Kosong = ikut penyedia utama di atas.
TRANSCRIBE_BASE_URL=
TRANSCRIBE_API_KEY=
TTS_BASE_URL=
TTS_API_KEY=

# Sumber tren. YouTube butuh key (Google Cloud Console -> aktifkan
# "YouTube Data API v3" -> Credentials -> API key). Gratis, kuota 10.000 unit/hari.
# Tanpa key, sistem tetap jalan dengan Google Trends RSS saja (tanpa key).
YOUTUBE_API_KEY=
TRENDS_GEO=ID

# Transkripsi audio bahan video. Tanpa ini model HANYA melihat 1 frame diam per
# video dan tidak pernah mendengar isinya — untuk video talking-head itu berarti
# hampir seluruh kontennya tidak terlihat sistem.
# Sumber suara video:
#   original = pakai audio ASLI video user, tanpa TTS  <- DEFAULT
#   ai       = selalu voice-over AI
#   auto     = sama dengan ai
# Mode 'original' OTOMATIS kembali ke voice-over AI kalau bahan ternyata tidak ada
# ucapannya (mis. hanya foto), supaya videonya tidak sunyi.
AUDIO_MODE=original

# --- Voice-over AI ---
# openai = gpt-4o-mini-tts, gayanya bisa diarahkan lewat instruksi (natural)
# edge   = edge-tts, gratis tapi terdengar kaku
# Kegagalan openai OTOMATIS jatuh ke edge, supaya kredit habis tidak
# menggagalkan render.
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
# Persona = pasangan suara + gaya bicara. Bisa diminta lewat chat juga.
# Pilihan: ramah | profesional | energik | tenang | bercerita
TTS_PERSONA=ramah
# Isi kalau mau menimpa persona dengan suara/instruksi sendiri.
# Suara yang tersedia: nova, onyx, shimmer, alloy, echo, fable, sage, coral
TTS_VOICE=
TTS_INSTRUCTIONS=
EDGE_TTS_VOICE=id-ID-GadisNeural
EDGE_TTS_RATE=+5%

# --- Tampilan subtitle ---
# Font dipilih lewat NAMA keluarga, bukan path (path beda antar distribusi).
# Lihat pilihan: fc-list : family
SUBTITLE_FONT=DejaVu Sans
SUBTITLE_FONT_WEIGHT=bold
# Gaya: putih-kotak | kuning-kotak | putih-tebal | kuning
SUBTITLE_STYLE=putih-kotak
# Ukuran font sebagai FRAKSI tinggi kanvas (bukan piksel), supaya proporsional
# otomatis di 9:16, 1:1, dan 16:9. 0.045 = 4,5% (patokan caption sosial media
# 4-5%; nilai lama 52px pada 1920 hanya 2,7% -- terlalu kecil di HP).
SUBTITLE_SIZE_RATIO=0.045
SUBTITLE_MAX_LINES=2
SAFE_BOTTOM_RATIO=0.156
# Durasi tampil satu GAMBAR saat mode audio asli (klip video pakai durasi aslinya).
IMAGE_CLIP_SECONDS=3

# --- Pemotongan jeda diam (mode audio asli) ---
# Diukur pada bahan nyata: ~18% durasi video bisa berupa ruang mati, dan hampir
# semua rekaman selfie diawali jeda sebelum orangnya mulai bicara.
# --- Rasio video & cara memuat bahan ---
# 9:16 (Reels/TikTok/Shorts) | 1:1 (feed IG) | 16:9 (YouTube)
VIDEO_ASPECT=9:16
# crop      = isi kanvas penuh, tepi terpotong (default)
# blur      = seluruh frame dipertahankan, latar versi blur dari gambar itu
# letterbox = seluruh frame dipertahankan, latar hitam
# Nilai tak dikenal DITOLAK sebelum render, bukan diam-diam jatuh ke default.
FIT_MODE=crop
# Blur dilakukan pada versi kecil ini lalu diperbesar -- gblur berbiaya
# kuadratik terhadap luas, jadi ini yang membuatnya nyaris gratis.
BLUR_SMALL_WIDTH=160
BLUR_SIGMA=18

# --- Transisi antar klip ---
# fade = redup ke hitam di ujung tiap segmen | none = potong mendadak
# Sengaja BUKAN crossfade (xfade): xfade memendekkan video sebesar durasi overlap
# di tiap sambungan, dan itu menggeser seluruh subtitle sesudahnya.
TRANSITION=fade
TRANSITION_DURATION=0.2
# Fade audio jauh lebih pendek: tujuannya hanya mencegah bunyi klik di sambungan,
# bukan memudarkan suara (0,2 dtk akan memotong suku kata).
AUDIO_FADE_DURATION=0.06

TRIM_SILENCE=1
SILENCE_NOISE_DB=-35
SILENCE_MIN_DURATION=0.35
# Bantalan di kedua ujung potongan supaya suku kata tidak ikut terpotong.
SILENCE_PAD=0.12
MIN_KEEP_DURATION=0.4

# Budget bulanan (USD) untuk dilaporkan ke user bersama biaya tiap konten.
# 0 = tidak melaporkan persentase, hanya total terpakai.
# CATATAN: OpenAI TIDAK mengekspos SISA SALDO lewat API (semua endpoint billing
# menjawab 403 dengan API key biasa). Angka di sini adalah budget yang KAMU
# tetapkan, dibandingkan dengan pemakaian dari catatan kita sendiri.
MONTHLY_BUDGET_USD=0

# Kosakata yang dibiaskan ke Whisper supaya serapan Inggris tidak ditulis
# fonetis ("leads" jadi "lid"). Kosongkan untuk memakai daftar bawaan.
TRANSCRIBE_VOCAB=

TRANSCRIBE_ENABLED=1
TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_MAX_SECONDS=600

# --- Posting ke Instagram/TikTok (opsional, lewat Zernio) ---
# Dibaca scripts/terbit.py. Dua langkah: `siapkan` (pratinjau, 30 menit, tanpa
# unggahan) lalu `kirim` dengan persetujuan user. Tanpa penjadwalan.
# Key hanya dikirim ke host Zernio, tidak pernah ke URL unggah.
ZERNIO_API_KEY=

# --- Voice-over ElevenLabs (opsional) ---
# Setel TTS_PROVIDER=elevenlabs di atas untuk mengaktifkannya (JANGAN tambah
# baris TTS_PROVIDER kedua: dotenv memakai yang terakhir).
# Tanpa key / kuota habis -> edge-tts gratis.
ELEVENLABS_API_KEY=
# Kosong = suara dipilih dari TTS_PERSONA. Isi untuk memaksa satu voice id.
ELEVENLABS_VOICE_ID=
# Bawaan eleven_multilingual_v2. JANGAN ditulis kosong: model kosong ditolak API. Buka # hanya untuk mengubah.
# ELEVENLABS_MODEL=eleven_multilingual_v2

# B-roll stok otomatis (opsional). Key gratis: https://www.pexels.com/api/
PEXELS_API_KEY=

# --- Remotion (teks animasi, carousel, cover) ---
# Path binari Chromium (chrome-headless-shell). Diisi otomatis oleh deploy/bootstrap.sh.
# Kosong = remotion/render.mjs memakai path Playwright bawaan (/root/.cache/ms-playwright/...).
REMOTION_CHROMIUM=
