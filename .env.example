OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=

# Chat tujuan untuk jalur CLI (pipeline.py) saja. TIDAK dipakai sebagai fallback
# jalur Telegram -- di sana tujuan selalu chat pemicu.
TELEGRAM_CHAT_ID=

# Daftar chat yang boleh memicu pipeline, dipisah koma. Contoh: 111111,222222
# GAGAL-TERTUTUP: kosong berarti TIDAK ADA yang diizinkan, bukan "semua boleh".
ALLOWED_CHAT_IDS=

# Sumber tren. YouTube butuh key (Google Cloud Console -> aktifkan
# "YouTube Data API v3" -> Credentials -> API key). Gratis, kuota 10.000 unit/hari.
# Tanpa key, sistem tetap jalan dengan Google Trends RSS saja (tanpa key).
YOUTUBE_API_KEY=
TRENDS_GEO=ID

APPROVAL_TIMEOUT_SECONDS=600
TARGET_PLATFORM=Instagram Reels

# --- Publikasi otomatis ke Instagram Reels (opsional) ---
# Kosong = tidak ada yang dipublikasikan otomatis; konten tetap diarsipkan di
# workspace/published/ dan user diminta upload manual.
#
# IG_USER_ID       : ID akun Instagram Business/Creator (BUKAN username).
# IG_ACCESS_TOKEN  : token long-lived dgn izin instagram_content_publish.
# PUBLIC_MEDIA_BASE_URL : alamat HTTPS publik yang menyajikan isi
#   workspace/published/. WAJIB: Graph API tidak menerima unggahan byte untuk
#   Reels -- kita mengirim video_url dan server Meta yang MENARIK filenya.
#   Contoh: https://konten.contoh.com/published
IG_USER_ID=
IG_ACCESS_TOKEN=
PUBLIC_MEDIA_BASE_URL=
